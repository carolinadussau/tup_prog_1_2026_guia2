Proceso MayorValor

    Definir num, numMayor Como Real;

    Escribir "Ingrese el primer numero:";
    Leer num;

    numMayor <- num;

    Escribir "Ingrese el segundo numero:";
    Leer num;

    Si num > numMayor Entonces
        numMayor <- num;
    FinSi

    Escribir "Ingrese el tercer numero:";
    Leer num;

    Si num > numMayor Entonces
        numMayor <- num;
    FinSi

    Escribir "Ingrese el cuarto numero:";
    Leer num;

    Si num > numMayor Entonces
        numMayor <- num;
    FinSi

    Escribir "Ingrese el quinto numero:";
    Leer num;

    Si num > numMayor Entonces
        numMayor <- num;
    FinSi

    Escribir "El mayor es: ", numMayor;

FinProceso