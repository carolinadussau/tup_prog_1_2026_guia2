Proceso PositivoNegativoCero

    Definir num Como Entero;

    Escribir "Ingrese número a evaluar:";
    Leer num;

    Si num < 0 Entonces
        Escribir "Es negativo";
    SiNo
        Si num = 0 Entonces
            Escribir "Es cero";
        SiNo
            Escribir "Es positivo";
        FinSi
    FinSi

FinProceso